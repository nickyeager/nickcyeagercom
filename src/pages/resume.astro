---
import Base from '../layouts/Base.astro';
---

<Base title="Resume" description="Nicholas Yeager — AI Solutions Architect, resume and work history.">
  <div class="flex items-center justify-between mb-8 print:hidden">
    <h1 class="text-xs text-terminal-muted uppercase tracking-widest">resume</h1>
    <a href="/resume.pdf" target="_blank" rel="noopener noreferrer"
      class="text-xs text-terminal-muted border border-terminal-border rounded px-3 py-1.5 hover:text-terminal-green hover:border-terminal-dim transition-colors duration-200 cursor-pointer">
      download pdf &darr;
    </a>
  </div>

  <div class="max-w-xl font-sans">

    <!-- Header -->
    <div class="mb-4">
      <h2 class="text-lg font-semibold text-terminal-text mb-1">Nicholas Yeager</h2>
      <p class="text-sm text-terminal-muted">Tucson, Arizona &middot; (760) 996-7075 &middot;
        <a href="mailto:yeag123@gmail.com" class="hover:text-terminal-green transition-colors duration-200 cursor-pointer">yeag123@gmail.com</a> &middot;
        <a href="https://www.linkedin.com/in/nicholas-yeager/" target="_blank" rel="noopener noreferrer" class="hover:text-terminal-green transition-colors duration-200 cursor-pointer">LinkedIn</a> &middot;
        <a href="https://github.com/nickyeager" target="_blank" rel="noopener noreferrer" class="hover:text-terminal-green transition-colors duration-200 cursor-pointer">GitHub</a>
      </p>
    </div>

    <!-- Professional Summary -->
    <section class="mb-4">
      <h3 class="text-xs text-terminal-muted uppercase tracking-widest mb-2 font-mono">Professional Summary</h3>
      <p class="text-sm leading-snug text-terminal-text/80">
        AI Solutions Architect who designs and ships production AI systems, with a focus on agent evaluation, observability, and LLM integration. Builds AI-driven pharmaceutical solutions at ScriptSave and independently built RuleMetric, a platform for measuring changes to AI coding-agent instructions. More than a decade of software engineering and cross-functional delivery across healthcare, finance, and startups. Former Co-Founder & CTO of Outlast (AngelPad). Earned Microsoft Certified: Azure AI Engineer Associate (Aug 2025).
      </p>
      <p class="text-sm leading-snug text-terminal-text mt-2">
        <span class="text-terminal-green font-medium">Selected product:</span>
        <a href="https://rulemetric.com" target="_blank" rel="noopener noreferrer" class="text-terminal-cyan hover:text-terminal-green transition-colors duration-200">RuleMetric</a> captures AI coding sessions and compares prompt, rule, and memory changes against a baseline, reporting quality, cost, and latency to help developers decide what to keep.
      </p>
    </section>

    <!-- Selected AI Product -->
    <section class="mb-4">
      <h3 class="text-xs text-terminal-muted uppercase tracking-widest mb-2 font-mono">Selected AI Product</h3>
      <p class="text-sm text-terminal-text/70 mb-4">Independently designed, built, and shipped RuleMetric, owning architecture, product roadmap, and delivery.</p>

      <div class="space-y-4">
        <div>
          <div class="flex items-start justify-between gap-4">
            <h4 class="text-sm font-semibold text-terminal-text">RuleMetric &mdash; evaluation and observability for AI coding agents</h4>
            <span class="text-xs text-terminal-muted shrink-0">rulemetric.com</span>
          </div>
          <p class="text-xs text-terminal-cyan mb-2">TypeScript/Node monorepo &middot; API, dashboard, eval worker &middot; public npm CLI: <span class="text-terminal-text/90">@rulemetric/cli</span></p>
          <ul class="text-sm text-terminal-text/70 space-y-1 list-disc list-inside">
            <li>Built session-capture integrations for Claude Code, Codex, Cursor, and GitHub Copilot, turning coding-session evidence into proposed instruction and workflow changes.</li>
            <li>Designed controlled evaluations that compare a proposed change with a baseline using the same harness, model, tasks, and grading approach, reporting quality, cost, latency, sample size, and uncertainty.</li>
            <li>Shipped a TypeScript/Node platform spanning an API, dashboard, background evaluation worker, and public npm CLI, with hosted and local deployment options.</li>
          </ul>
        </div>

      </div>
    </section>

    <!-- Work Experience -->
    <section class="mb-4">
      <h3 class="text-xs text-terminal-muted uppercase tracking-widest mb-2 font-mono">Work Experience</h3>

      <div class="space-y-4">
        <div>
          <div class="flex items-start justify-between gap-4">
            <h4 class="text-sm font-semibold text-terminal-text">AI Solutions Architect</h4>
            <span class="text-xs text-terminal-muted shrink-0">Feb 2026 - Present</span>
          </div>
          <p class="text-xs text-terminal-cyan mb-2">ScriptSave &middot; Tucson, Arizona</p>
          <ul class="text-sm text-terminal-text/70 space-y-1 list-disc list-inside">
            <li>Spearheading the architectural design and deployment of AI-driven pharmaceutical solutions.</li>
            <li>Integrating advanced LLM workflows and Azure AI services to enhance product capabilities.</li>
          </ul>
        </div>

        <div>
          <div class="flex items-start justify-between gap-4">
            <h4 class="text-sm font-semibold text-terminal-text">Senior Software Engineer</h4>
            <span class="text-xs text-terminal-muted shrink-0">Feb 2023 - Feb 2026</span>
          </div>
          <p class="text-xs text-terminal-cyan mb-2">ScriptSave &middot; Tucson, Arizona</p>
          <ul class="text-sm text-terminal-text/70 space-y-1 list-disc list-inside">
            <li>Implemented modern project management methods and frameworks to drive team alignment and efficiency.</li>
            <li>Deployed multiple new products using modern APIs.</li>
          </ul>
        </div>

        <div>
          <div class="flex items-start justify-between gap-4">
            <h4 class="text-sm font-semibold text-terminal-text">Software Engineer</h4>
            <span class="text-xs text-terminal-muted shrink-0">Jan 2022 - Jan 2023</span>
          </div>
          <p class="text-xs text-terminal-cyan mb-2">Alicat Scientific &middot; Tucson, Arizona</p>
          <ul class="text-sm text-terminal-text/70 space-y-1 list-disc list-inside">
            <li>Modernized a legacy backend and frontend system.</li>
            <li>Introduced deployment workflows that reduced downtime and errors in a legacy environment.</li>
            <li>Developed a custom CI solution to automate integrations and accelerate release cycles.</li>
            <li>Implemented thorough testing and raised coverage for a large CRM platform.</li>
          </ul>
        </div>

        <div>
          <div class="flex items-start justify-between gap-4">
            <h4 class="text-sm font-semibold text-terminal-text">Software Engineer</h4>
            <span class="text-xs text-terminal-muted shrink-0">Apr 2021 - Dec 2021</span>
          </div>
          <p class="text-xs text-terminal-cyan mb-2">USAA (Contract) &middot; Phoenix, Arizona</p>
          <ul class="text-sm text-terminal-text/70 space-y-1 list-disc list-inside">
            <li>Rebuilt core frontend components for their umbrella insurance application.</li>
            <li>Established updated testing and deployment workflows to improve release consistency.</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Additional Experience -->
    <section class="mb-4">
      <h3 class="text-xs text-terminal-muted uppercase tracking-widest mb-2 font-mono">Additional Experience</h3>
      <div class="space-y-2 text-sm text-terminal-text/70">
        <div class="flex items-start justify-between gap-4">
          <span><span class="text-terminal-text/90 font-medium">Software Engineer (contract)</span> &middot; Delta Thermal Inc</span>
          <span class="text-xs text-terminal-muted shrink-0">2024</span>
        </div>
        <div class="flex items-start justify-between gap-4">
          <span><span class="text-terminal-text/90 font-medium">Senior Software Engineer</span> &middot; ScriptSave WellRx</span>
          <span class="text-xs text-terminal-muted shrink-0">Jun 2020 - Jan 2021</span>
        </div>
        <div class="flex items-start justify-between gap-4">
          <span><span class="text-terminal-text/90 font-medium">Senior Architect</span> &middot; overlandbound.com</span>
          <span class="text-xs text-terminal-muted shrink-0">Jan - Jun 2020</span>
        </div>
        <div class="flex items-start justify-between gap-4">
          <span><span class="text-terminal-text/90 font-medium">Co-Founder & CTO</span> &middot; Outlast (formerly Quoteapro)</span>
          <span class="text-xs text-terminal-muted shrink-0">Nov 2017 - Sep 2019</span>
        </div>
        <div class="flex items-start justify-between gap-4">
          <span><span class="text-terminal-text/90 font-medium">Senior Software Engineer</span> &middot; Outlast</span>
          <span class="text-xs text-terminal-muted shrink-0">Sep 2019 - Jan 2020</span>
        </div>
        <div class="flex items-start justify-between gap-4">
          <span><span class="text-terminal-text/90 font-medium">Founder & Partner</span> &middot; Rincon Strategies</span>
          <span class="text-xs text-terminal-muted shrink-0">Jun 2015 - Nov 2017</span>
        </div>
        <div class="flex items-start justify-between gap-4">
          <span><span class="text-terminal-text/90 font-medium">Developer / Project Manager</span> &middot; Elegant Thought</span>
          <span class="text-xs text-terminal-muted shrink-0">May 2012 - Apr 2015</span>
        </div>
      </div>
    </section>

    <!-- Education -->
    <section class="mb-4">
      <h3 class="text-xs text-terminal-muted uppercase tracking-widest mb-2 font-mono">Education</h3>
      <p class="text-sm text-terminal-text/80">Bachelor of Arts in Political Science and Government</p>
      <p class="text-xs text-terminal-muted">University of Arizona &middot; Tucson, Arizona</p>
      <p class="text-sm text-terminal-text/80 mt-3">AngelPad &middot; Seed-stage startup accelerator (2017&ndash;2018)</p>
    </section>

    <!-- Skills -->
    <section class="mb-4">
      <h3 class="text-xs text-terminal-muted uppercase tracking-widest mb-2 font-mono">Skills</h3>
      <div class="space-y-1 text-sm">
        <div>
          <span class="text-terminal-text/90 font-medium">Leadership:</span>
          <span class="text-terminal-text/70"> Team leadership, Cross-functional collaboration, Public speaking</span>
        </div>
        <div>
          <span class="text-terminal-text/90 font-medium">AI & Cloud:</span>
          <span class="text-terminal-text/70"> Agent evaluation, Controlled experiments, LLM observability, Azure AI Services, LLM integration, Prompt engineering</span>
        </div>
        <div>
          <span class="text-terminal-text/90 font-medium">Backend:</span>
          <span class="text-terminal-text/70"> .NET Core, Laravel, Node.js, Phoenix, Flask</span>
        </div>
        <div>
          <span class="text-terminal-text/90 font-medium">Frontend:</span>
          <span class="text-terminal-text/70"> ReactJS, React Native, Blazor</span>
        </div>
        <div>
          <span class="text-terminal-text/90 font-medium">Languages:</span>
          <span class="text-terminal-text/70"> Python, PHP, TypeScript, JavaScript, Objective-C, Ruby, HTML, CSS, SQL, C#</span>
        </div>
      </div>
    </section>

    <!-- Hobbies -->
    <section>
      <h3 class="text-xs text-terminal-muted uppercase tracking-widest mb-2 font-mono">Hobbies</h3>
      <p class="text-sm text-terminal-text/70">Pickleball Coach</p>
    </section>

  </div>
</Base>
